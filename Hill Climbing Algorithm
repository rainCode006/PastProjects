        "import random\n",
        "\n",
        "#simple function to perform the formula for hill climbing problem\n",
        "def formula(x):\n",
        "    solution = 2-x**2 #plugs the value into the formula\n",
        "    return solution\n",
        "\n",
        "#simple function to perform formula for second problem\n",
        "def formula2(x):\n",
        "    solution = (0.0051*(x)**5) - (0.1367*(x)**4) + (1.24*(x)**3) - (4.456*(x)**2) + (5.66*(x)) - 0.287 #plugs the value into the formula\n",
        "    return solution"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "This is the implementation of the general hill climbing algorithm, it was implemented under the assumption the algorithm would start from the left most limit of the range and search its neighbor to the right until the top value was found."
      ],
      "metadata": {
        "id": "q3sQU0o3maJ2"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "#performs the hill climbing algorithm to find the max\n",
        "def hill_climbing(min_lim,max_lim,step_size): #gets the minimum, maximum, and step size for the formula\n",
        "    current = min_lim\n",
        "    neighbor = current + step_size #neighbor is first assigned to the left of the current value\n",
        "    while formula(neighbor) > formula(current):#while the neighbor's value is higher than the current, move to the nieghbor's value\n",
        "        current = neighbor #current gets neighbor's value\n",
        "        neighbor = neighbor + step_size #nieghbor iterates again  to the left\n",
        "        if(current == max_lim or neighbor > max_lim): #if the current reaches the minimum or the neighbor surpasses it stop\n",
        "            return current\n",
        "    return current #default return"
      ],
