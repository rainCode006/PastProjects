    {
      "cell_type": "code",
      "source": [
        "#performs the hill climbing algorithm to find the max using random points\n",
        "#the function is largely the same as the previous but sets current to a random point in the range of the problem\n",
        "#the function uses formula2 instead of formula\n",
        "def rand_hill_climbing(min_lim,max_lim,step_size): #gets the minimum, maximum, and step size for the formula\n",
        "    current = random.randrange(min_lim,max_lim) #start at a random point in the range of the problem\n",
        "    neighbor = current - step_size #neighbor is first assigned to the left of the current value\n",
        "    ###################################################If the iteration is positive###############################################\n",
        "    if(formula2(neighbor) < formula2(current+step_size)): #if the solution value is higher to the right, change nieghbor value to the right\n",
        "        neighbor = current + step_size\n",
        "        while formula2(neighbor) > formula2(current):#while the neighbor's value is higher than the current, move to the nieghbor's value\n",
        "            current = neighbor #current gets neighbor's value\n",
        "            neighbor = neighbor + step_size #nieghbor iterates again to the right\n",
        "            if(current == max_lim or neighbor > max_lim): #if the current reaches the max or the neighbor passes it stop\n",
        "                return current\n",
        "    ###################################################If the iteration is negative###############################################\n",
        "    while formula2(neighbor) > formula2(current):#while the neighbor's value is higher than the current, move to the nieghbor's value\n",
        "        current = neighbor #current gets neighbor's value\n",
        "        neighbor = neighbor - step_size #nieghbor iterates again  to the left\n",
        "        if(current == min_lim or neighbor < min_lim): #if the current reaches the minimum or the neighbor surpasses it stop\n",
        "            return current\n",
        "    return current #default return"
      ],
