      "source": [
        "#loads the iris dataset for problem\n",
        "iris = load_iris()\n",
        "\n",
        "#split data into training, validation, and training sets\n",
        "X, y = iris.data, iris.target\n",
        "\n",
        "#creates the decision tree\n",
        "clf = tree.DecisionTreeClassifier(max_depth=5\n",
        ", criterion='entropy', min_samples_leaf=3) #hyperparameters changed here to change performance of data\n",
        "clf = clf.fit(X, y)\n",
        "\n",
        "#plots the data\n",
        "tree.plot_tree(clf)"
