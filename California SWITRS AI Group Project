        "### Logisitic regression\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.metrics import classification_report, confusion_matrix, ConfusionMatrixDisplay\n",
        "from sklearn.pipeline import Pipeline\n",
        "from sklearn.experimental import enable_halving_search_cv\n",
        "from sklearn.model_selection import HalvingRandomSearchCV\n",
        "from sklearn.model_selection import StratifiedKFold\n",
        "\n",
        "model = Pipeline(steps=[\n",
        "    ('preprocess', preprocess),\n",
        "    ('clf', LogisticRegression(random_state=0,\n",
        "                         C=1.0,\n",
        "                         class_weight='balanced',\n",
        "                         solver='saga',\n",
        "                         penalty='l2',\n",
        "                         fit_intercept=True))\n",
        "])\n",
        "\n",
        "model.fit(train_X, train_y)\n",
        "\n",
        "# Predict training set\n",
        "train_pred = model.predict(train_X)\n",
        "train_metrics = confusion_matrix(train_y, train_pred)\n",
        "\n",
        "class_names = [\"Non-fatal\", \"Fatal\"]\n",
        "disp = ConfusionMatrixDisplay(confusion_matrix=train_metrics, display_labels=class_names)\n",
        "disp.plot(cmap=plt.cm.Blues, values_format='.2f')\n",
        "plt.show()\n",
        "\n",
        "print(\"Training results\")\n",
        "print(classification_report(train_y, train_pred))\n",
        "print(train_metrics)\n",
        "\n",
        "# Predict validation set\n",
        "val_pred = model.predict(validation_X)\n",
        "val_metrics = confusion_matrix(validation_y, val_pred)\n",
        "\n",
        "class_names = [\"Non-fatal\", \"Fatal\"]\n",
        "disp = ConfusionMatrixDisplay(confusion_matrix=val_metrics, display_labels=class_names)\n",
        "disp.plot(cmap=plt.cm.Blues, values_format='.2f')\n",
        "plt.show()\n",
        "\n",
        "print(\"Validation results\")\n",
        "print(classification_report(validation_y, val_pred))\n",
        "print(val_metrics)\n",
        "\n",
        "# Predict test set\n",
        "test_pred = model.predict(test_X)\n",
        "test_metrics = confusion_matrix(test_y, test_pred)\n",
        "\n",
        "class_names = [\"Non-fatal\", \"Fatal\"]\n",
        "disp = ConfusionMatrixDisplay(confusion_matrix=test_metrics, display_labels=class_names)\n",
        "disp.plot(cmap=plt.cm.Blues, values_format='.2f')\n",
        "plt.show()\n",
        "\n",
        "print(\"Test results\")\n",
        "print(classification_report(test_y, test_pred))\n",
        "print(test_metrics)\n",
        "\n",
