        "### Random Forest MOdel\n",
        "\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from sklearn.experimental import enable_halving_search_cv\n",
        "from sklearn.model_selection import HalvingRandomSearchCV\n",
        "from sklearn.pipeline import Pipeline\n",
        "\n",
        "# Use pipeline to integrate preprocessing\n",
        "# The hyperparameters used are the ones selected after tuning\n",
        "model = Pipeline(steps=[\n",
        "    ('preprocess', preprocess),\n",
        "    ('clf', RandomForestClassifier(\n",
        "        n_estimators=100,\n",
        "        max_depth=10,\n",
        "        min_samples_split=10,\n",
        "        min_samples_leaf=2,\n",
        "        max_features=2,\n",
        "        class_weight='balanced',\n",
        "        n_jobs=-1\n",
        "    ))\n",
        "])\n",
        "\n",
        "model.fit(train_X, train_y)\n",
        "\n",
        "# Change threshold to improve recall\n",
        "def predict_with_threshold(model, X, threshold=0.5):\n",
        "    y_prob = model.predict_proba(X)[:, 1]\n",
        "    return (y_prob > threshold).astype(int)\n",
        "\n",
        "# Predict Training Set\n",
        "train_pred = predict_with_threshold(model, train_X, 0.5)\n",
        "\n",
        "print(\"Training Results\")\n",
        "print(classification_report(train_y, train_pred))\n",
        "\n",
        "ConfusionMatrixDisplay.from_predictions(\n",
        "    train_y, train_pred, display_labels=[\"Non-fatal\", \"Fatal\"], cmap=\"Blues\"\n",
        ")\n",
        "plt.title(\"Training Confusion Matrix\")\n",
        "plt.show()\n",
        "\n",
        "# Predict validation set\n",
        "val_pred = predict_with_threshold(model, validation_X, 0.5)\n",
        "\n",
        "print(\"Validation Results\")\n",
        "print(classification_report(validation_y, val_pred))\n",
        "\n",
        "ConfusionMatrixDisplay.from_predictions(\n",
        "    validation_y, val_pred, display_labels=[\"Non-fatal\", \"Fatal\"], cmap=\"Blues\"\n",
        ")\n",
        "plt.title(\"Validation Confusion Matrix\")\n",
        "plt.show()\n",
        "\n",
        "# Predict test set\n",
        "test_pred = predict_with_threshold(model, test_X, 0.5)\n",
        "\n",
        "print(\"Test Results\")\n",
        "print(classification_report(test_y, test_pred))\n",
        "\n",
        "ConfusionMatrixDisplay.from_predictions(\n",
        "    test_y, test_pred, display_labels=[\"Non-fatal\", \"Fatal\"], cmap=\"Blues\"\n",
        ")\n",
        "plt.title(\"Test Confusion Matrix\")\n",
        "plt.show()\n",
        "\n",
        "\"\"\"\n",
        "# Hyper paramter tuning, commented out to run faster\n",
        "param_dist = {\n",
        "    \"clf__n_estimators\": [100, 200, 300],\n",
        "    \"clf__max_depth\": [10, 20, 30, None],\n",
        "    \"clf__min_samples_split\": [2, 5, 10],\n",
        "    \"clf__min_samples_leaf\": [1, 2, 4],\n",
        "    \"clf__max_features\": [\"sqrt\", \"log2\"],\n",
        "}\n",
        "\n",
        "search = HalvingRandomSearchCV(\n",
        "    estimator=model,\n",
        "    param_distributions=param_dist,\n",
        "    factor=3,\n",
        "    resource=\"n_samples\",   # You can keep this if you want n_samples as the resource\n",
        "    max_resources=300,\n",
        "    min_resources=50,\n",
        "    scoring=\"recall\",\n",
        "    n_jobs=-1,\n",
        "    random_state=42,\n",
        "    verbose=2\n",
        ")\n",
        "\n",
        "search.fit(train_X, train_y)\n",
        "\n",
        "print(\"Best parameters:\", search.best_params_)\n",
        "print(\"Best score:\", search.best_score_)\n",
        "\"\"\""
