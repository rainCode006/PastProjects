        "### Neural network\n",
        "import numpy as np\n",
        "from tensorflow.keras.models import Sequential\n",
        "from tensorflow.keras.layers import Dense, Dropout\n",
        "from tensorflow.keras.optimizers import Adam\n",
        "from sklearn.utils import class_weight\n",
        "from sklearn.metrics import accuracy_score, confusion_matrix, classification_report\n",
        "\n",
        "# Apply preprocessing to the training, validation, and test data\n",
        "processed_train_X = preprocess.fit_transform(train_X)\n",
        "processed_validation_X = preprocess.transform(validation_X)\n",
        "processed_test_X = preprocess.transform(test_X)\n",
        "\n",
        "# Calculate class weights for imbalanced dataset\n",
        "class_weights = class_weight.compute_class_weight(\n",
        "    class_weight='balanced',\n",
        "    classes=np.unique(train_y),\n",
        "    y=train_y\n",
        ")\n",
        "class_weights_dict = dict(enumerate(class_weights))\n",
        "\n",
        "# Define the neural network architecture\n",
        "model = Sequential()\n",
        "\n",
        "# Add input layer and first hidden layer with Dropout\n",
        "model.add(Dense(units=128, input_dim=processed_train_X.shape[1], activation='relu'))\n",
        "model.add(Dropout(0.3)) #Add dropout for regularization\n",
        "\n",
        "# Add a second hidden layer with Dropout\n",
        "model.add(Dense(units=64, activation='relu'))\n",
        "model.add(Dropout(0.3)) #Add dropout for regularization\n",
        "\n",
        "# Add output layer\n",
        "model.add(Dense(units=1, activation='sigmoid'))\n",
        "\n",
        "# Compile the model\n",
        "model.compile(optimizer=Adam(), loss='binary_crossentropy', metrics=['accuracy'])\n",
        "\n",
        "# Train the model with class weights\n",
        "history = model.fit(\n",
        "    processed_train_X,\n",
        "    train_y,\n",
        "    epochs=5,\n",
        "    batch_size=64,\n",
        "    validation_split=0.2,\n",
        "    verbose=1,\n",
        "    class_weight=class_weights_dict\n",
        ")\n",
        "\n",
        "# Predict Training Set\n",
        "train_pred = (model.predict(processed_train_X) > 0.5)  #Convert probabilities to binary outcomes (0 or 1)\n",
        "\n",
        "print(\"Training Results\")\n",
        "print(classification_report(train_y, train_pred))\n",
        "\n",
        "ConfusionMatrixDisplay.from_predictions(\n",
        "    train_y, train_pred, display_labels=[\"Non-fatal\", \"Fatal\"], cmap=\"Blues\"\n",
        ")\n",
        "plt.title(\"Training Confusion Matrix\")\n",
        "plt.show()\n",
        "\n",
        "# Predict Test Set\n",
        "test_pred = (model.predict(processed_test_X) > 0.5)  #Convert probabilities to binary outcomes (0 or 1)\n",
        "\n",
        "print(\"Test Results\")\n",
        "print(classification_report(test_y, test_pred))\n",
        "\n",
        "ConfusionMatrixDisplay.from_predictions(\n",
        "    test_y, test_pred, display_labels=[\"Non-fatal\", \"Fatal\"], cmap=\"Blues\"\n",
        ")\n",
        "plt.title(\"Test Confusion Matrix\")\n",
        "plt.show()\n"
