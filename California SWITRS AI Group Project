        "### Load dataset and pre-process\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import OneHotEncoder\n",
        "from sklearn.compose import ColumnTransformer\n",
        "from sklearn.impute import SimpleImputer\n",
        "from sklearn.metrics import classification_report, confusion_matrix, ConfusionMatrixDisplay\n",
        "import matplotlib.pyplot as plt\n",
        "import pandas as pd\n",
        "from sklearn.pipeline import Pipeline\n",
        "\n",
        "# Get accident data from Google Drive\n",
        "from google.colab import drive\n",
        "drive.mount('/content/gdrive')\n",
        "\n",
        "# File with accident data\n",
        "file = \"gdrive/My Drive/reduced_collisions.parquet\"\n",
        "\n",
        "# Load the CSV file into a DataFrame\n",
        "df = pd.read_parquet(file)\n",
        "\n",
        "# Convert killed victims into boolean type (0 if no one was killed, 1 if someone was killed)\n",
        "df['fatal'] = (\n",
        "    df['killed_victims'] +\n",
        "    df['pedestrian_killed_count'] +\n",
        "    df['bicyclist_killed_count'] +\n",
        "    df['motorcyclist_killed_count']\n",
        ") > 0\n",
        "\n",
        "df['fatal'] = df['fatal'].astype(int)\n",
        "\n",
        "# Drop roads since they don't seem to have an impact on accuracy\n",
        "df = df.drop(columns=['primary_road'])\n",
        "df = df.drop(columns=['secondary_road'])\n",
        "\n",
        "# Drop extar weather and road conditions since more than 90% of these values are missing\n",
        "df = df.drop(columns=['weather_2'])\n",
        "df = df.drop(columns=[\"road_condition_2\"])\n",
        "\n",
        "# Transform collision_time into datetime object so we can extract hours and minutes\n",
        "df[\"collision_time\"] = pd.to_datetime(df[\"collision_time\"], format=\"%H:%M:%S\")\n",
        "\n",
        "# Extract hour and minute, seconds not really relevant. Save in new columns.\n",
        "df[\"hour\"] = df[\"collision_time\"].dt.hour\n",
        "df[\"minute\"] = df[\"collision_time\"].dt.minute\n",
        "\n",
        "# Drop collision time\n",
        "df = df.drop(columns=['collision_time'])\n",
        "\n",
        "# Fill alcohol_involved with 0's if values are missing (assume not involved)\n",
        "df['alcohol_involved'] = df['alcohol_involved'].fillna(0)\n",
        "\n",
        "# Fill missing location type with unknown as category\n",
        "df['location_type'] = df['location_type'].fillna('Unknown')\n",
        "\n",
        "# Fill missing latitude and longitude with median and add extra columns to indicate if it was missing\n",
        "df['lat_missing'] = df['latitude'].isna().astype(int)\n",
        "df['lon_missing'] = df['longitude'].isna().astype(int)\n",
        "\n",
        "df['latitude'] = df['latitude'].fillna(df['latitude'].median())\n",
        "df['longitude'] = df['longitude'].fillna(df['longitude'].median())\n",
        "\n",
        "# Separate into X and y\n",
        "X = df.drop(columns=[\n",
        "    'fatal',\n",
        "    'killed_victims',\n",
        "    'pedestrian_killed_count',\n",
        "    'bicyclist_killed_count',\n",
        "    'motorcyclist_killed_count',\n",
        "    'collision_severity'\n",
        "])\n",
        "\n",
        "y = df['fatal']\n",
        "\n",
        "# Identify categorical and numerical columns\n",
        "categorical_cols = X.select_dtypes(include=['object']).columns.tolist()\n",
        "numeric_cols = X.select_dtypes(include=['int64', 'float64']).columns.tolist()\n",
        "\n",
        "# Preprocessing for categorical data\n",
        "cat_pipeline = Pipeline(steps=[\n",
        "    ('imputer', SimpleImputer(strategy='most_frequent')),\n",
        "    ('onehot', OneHotEncoder(handle_unknown='ignore'))\n",
        "])\n",
        "\n",
        "# Preprocessing for numerical data\n",
        "num_pipeline = Pipeline(steps=[\n",
        "    ('imputer', SimpleImputer(strategy='median'))\n",
        "])\n",
        "\n",
        "# Combine them in a ColumnTransformer\n",
        "preprocess = ColumnTransformer(\n",
        "    transformers=[\n",
        "        ('cat', cat_pipeline, categorical_cols),\n",
        "        ('num', num_pipeline, numeric_cols)\n",
        "    ]\n",
        ")\n",
        "\n",
        "# Split into training, validation and test\n",
        "# 60% train, 20% validation, 20% test\n",
        "train_val_X, test_X, train_val_y, test_y = train_test_split(\n",
        "    X, y, test_size=0.20, random_state=42, stratify=y\n",
        ")\n",
        "\n",
        "train_X, validation_X, train_y, validation_y = train_test_split(\n",
        "    train_val_X, train_val_y, test_size=0.25, random_state=42, stratify=train_val_y\n",
        ")"
      ]
