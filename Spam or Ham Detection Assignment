        "#function that provides the total number of words in a spam/ham data set\n",
        "def adddict(dictionary):\n",
        "    truetotal = 0\n",
        "    for val in dictionary:\n",
        "        truetotal = truetotal + dictionary[val]\n",
        "    return truetotal"
