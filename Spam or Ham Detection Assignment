        "#function that takes the words in a string, establishes them if they're unique, and increments their count\n",
        "def wordfill(data):\n",
        "    i = dict() #establish a blank dictionary to hold the values\n",
        "\n",
        "    words = data.split() #split the provided string into words\n",
        "\n",
        "    for word in words: #for the length of the string\n",
        "        if word in i: #if the word already was found, increment it\n",
        "            i[word] = i[word] + 1\n",
        "        else: #if the word is new, establish it and set it equal to 1\n",
        "            i[word] = 1\n",
        "    return i #return the dictionary of words and counts"
      ]
    },
