        "spam = 0\n",
        "ham = 0\n",
        "spamtotal = dict() #final dictionary that will collect the values through the looped dictionaries of spam\n",
        "hamtotal = dict() #final dictionary that will collect the values through the looped dictionaries of ham\n",
        "with open(\"SpamDetection.csv\") as data: #read in spamdetection file and automatically close when done\n",
        "    data.readline() #read in to skip first line of lables: test and data\n",
        "    for x in range(20): #read in the training data\n",
        "        train = data.readline()\n",
        "        train = train.lower() #format all strings into lowercase\n",
        "        train = train.split(\",\") #split the string into the spam/ham identifier, and the sentence itself\n",
        "        if (train[0] == \"spam\"): #if the sentence is a spam\n",
        "            spam += 1\n",
        "            spamfill = wordfill(train[1]) #get every word in the spam sentence and increment it up\n",
        "            for y in spamfill.keys(): #for the length of values in the spamfill dictionary\n",
        "                if y in spamtotal: #if the current key exists in the total count\n",
        "                    spamtotal[y] += 1\n",
        "                else: #if the current key does not exist in the total count, establish it there and set it equal to 1\n",
        "                    spamtotal[y] = 1\n",
        "        else: #if the sentence is a ham\n",
        "            ham += 1\n",
        "            hamfill = wordfill(train[1]) #get every word in the ham sentence and increment it up\n",
        "            for z in hamfill.keys(): #for the length of values in the spamfill dictionary\n",
        "                 if z in hamtotal: #if the current key exists in the total count\n",
        "                    hamtotal[z] += 1\n",
        "                 else: #if the current key does not exist in the total count, establish it there and set it equal to 1\n",
        "                    hamtotal[z] = 1\n",
        "    itr = 0 #variable to iterate a simple number for display text\n",
        "    for y in range(10): #read in the test data\n",
        "        itr += 1\n",
        "        test = data.readline() #read in the test message\n",
        "        print(\"Message \", itr, \":\", test) #print the test message\n",
        "        test = test.lower() #format all strings into lowercase\n",
        "        hold_spam = [] #list to hold spam calculations\n",
        "        hold_ham = [] #list to hold ham calculations\n",
        "        test = test.split(\",\")\n",
        "        words = test[1].split() #iterates through each word in the string\n",
        "        for word in words: #compute probability message is spam or ham\n",
        "            temp_var = (spamtotal.get(word, 0)+1)/(adddict(spamtotal)+len(spamtotal)) #peform math for lapace smoothing for spam\n",
        "            hold_spam.append(temp_var) #add the equation into the spam list\n",
        "            temp_var = (hamtotal.get(word, 0)+1)/(adddict(hamtotal)+len(hamtotal)) #perform math for laplace smoothing for ham\n",
        "            hold_ham.append(temp_var) #add the equation into the ham list\n",
        "        probspam = spam/20 #initilize value that will hold posterior probability for spam\n",
        "        probham = ham/20 #initialize value that will hold posterior probability for ham\n",
        "        for x in hold_spam: #perform the calculations for determining posterior probability of spam\n",
        "            probspam = probspam * x\n",
        "        for x in hold_ham: # perform the calclulations for determining posterior probability of ham\n",
        "            probham = probham * x\n",
        "        print(probspam)\n",
        "        print(probham)\n",
        "        if(probspam > probham): #if the spam is a higher value, the message is spam\n",
        "            print(\"Posterior probability: \", probspam)\n",
        "            print(\"This message is spam\\n\")\n",
        "        else: #if the ham is a higher value, the message is ham\n",
        "            print(\"Posterior probability: \", probham)\n",
        "            print(\"This message is ham\\n\")"
